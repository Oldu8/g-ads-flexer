# Copy to .env.local (gitignored) for local development. Never commit values.

# Public origin of the site, used for metadata and the sitemap.
SITE_URL=http://localhost:3000

# Keep search engines out until the final name and domain (ROADMAP 0.2a).
ALLOW_INDEXING=false

# --- Database (Supabase) ------------------------------------------------------
# Admin connection, only for `npm run db:setup-roles`: the Session pooler
# string of the `postgres` user (Supabase -> Connect -> Session pooler).
ADMIN_DATABASE_URL=
# Written by db:setup-roles: the web role of this environment (web_dev locally)
# through the session pooler, and its schema.
DATABASE_URL=
DB_SCHEMA=app_dev

# --- Auth (Better Auth + Google) ---------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# OAuth client of type "Web application" in Cloud project 178951272716. Must be
# the same client the MCP server uses (a refresh token only works with it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Different in dev and prod.
TOKEN_ENCRYPTION_KEY=

# --- MCP (track B2) ---------------------------------------------------------
# Base of the MCP server's per-account URLs: an account's address is
# <MCP_PUBLIC_URL>/<mcp_slug>. It is also the OAuth resource tokens are bound
# to, so it must match the MCP server exactly. Locally the MCP server runs on
# http://localhost:8000/mcp (loopback http is allowed); prod is
# https://ads-mcp.vtrata.com/mcp.
MCP_PUBLIC_URL=http://localhost:8000/mcp
